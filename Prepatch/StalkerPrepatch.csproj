<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TheStalkerPrepatch</AssemblyName>
    <RootNamespace>TheStalkerPrepatch</RootNamespace>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup><Managed Condition="'$(Managed)' == '' And '$(SPT_MANAGED)' != ''">$(SPT_MANAGED)</Managed><Managed Condition="'$(Managed)' == ''">../References</Managed></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(Managed)/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(Managed)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MoreBotsPrepatch"><HintPath>../libs/MoreBotsPrepatch.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
